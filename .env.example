# Dirección de CampusChain.sol desplegado en Products Devnet (chainId 420420417).
# Se incrusta en el build: cada despliegue nuevo necesita actualizar este valor y volver a publicar.
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Configuración web de Firebase (console → Project settings → General → Your apps → SDK setup).
# No es secreta; los datos los protege firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Nombre .dot final, solo para polkadot-app-deploy.config.mjs (no se usa en el código de la app).
APP_DOT=
